---
import IconList from "@/assets/icons/IconList.svg";

type Props = {
  series: string;
  seriesName: string;
  count?: number;
  size?: "sm" | "lg";
};

const { series, seriesName, count, size = "lg" } = Astro.props;
---

<li>
  <a
    href={`/series/${series}/`}
    transition:name={series}
    class:list={[
      "flex items-center gap-1",
      "border-b-2 border-dashed border-foreground",
      "hover:-mt-0.5 hover:border-accent hover:text-accent",
      "focus-visible:border-none focus-visible:text-accent",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconList
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {seriesName}
    {count != null && <span class="text-foreground/70">({count})</span>}
  </a>
</li>

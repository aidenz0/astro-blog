---
/**
 * BlogStats - 博客文章字数统计组件
 * 显示总文章数、总字数、预计阅读时间
 */
import { getCollection } from "astro:content";

interface StatItem {
  label: string;
  value: string | number;
}

// 获取所有文章
const allPosts = await getCollection("blog");

// 统计数据
const totalPosts = allPosts.length;
let totalWords = 0;
let totalChars = 0;

for (const post of allPosts) {
  const content = post.body || "";
  if (!content) continue;

  try {
    // 统计中文字符数（包括汉字和中文标点）
    const chineseChars = (content.match(/[一-龥　-〿＀-￯]/g) || []).length;
    // 统计英文单词数
    const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;

    totalChars += chineseChars + englishWords;
    // 中文按字符数算，英文按单词数算
    totalWords += chineseChars + englishWords;
  } catch (error) {
    console.error(`Error processing post: ${post.id}`, error);
    continue;
  }
}

// 预计阅读时间（中文按400字/分钟，英文按200词/分钟）
const estimatedMinutes = Math.ceil(totalWords / 400);
const readingTime = estimatedMinutes < 60
  ? `${estimatedMinutes} 分钟`
  : `${Math.floor(estimatedMinutes / 60)} 小时 ${estimatedMinutes % 60} 分钟`;

// 格式化数字（添加千位分隔符）
const formatNumber = (num: number): string => {
  return num.toLocaleString("zh-CN");
};

const stats: StatItem[] = [
  { label: "文章总数", value: totalPosts },
  { label: "总字数", value: formatNumber(totalWords) },
  { label: "预计阅读时间", value: readingTime },
];
---

<section class="blog-stats" aria-label="博客统计信息">
  <div class="stats-container">
    {stats.map((stat) => (
      <div class="stat-item">
        <span class="stat-label">{stat.label}:</span>
        <span class="stat-value">{stat.value}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .blog-stats {
    width: 100%;
    margin-top: 1.5rem;
    padding: 1rem 0;
  }

  .stats-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.875rem;
    color: inherit;
  }

  .stat-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-label {
    font-weight: normal;
  }

  .stat-value {
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .stats-container {
      font-size: 0.75rem;
      gap: 0.5rem;
    }
  }
</style>

---
import IconClock from "@/assets/icons/IconClock.svg";

type Props = {
  minutes: number;
  words: number;
  class?: string;
};

const { minutes, words, class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  <IconClock class="inline-block size-6 min-w-5.5" />
  <span class="text-sm">
    {minutes} 分钟阅读
  </span>
  <span class="text-sm">·</span>
  <span class="text-sm">
    {words} 字
  </span>
</div>
